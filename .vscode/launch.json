    "version": "0.2.0",
    "configurations": [

        {
            "type": "bun",
            "request": "launch",
            "name": "Debug Fetch Script",
            "runtimeArgs": [
                "run",
                "src/downloader"
            ],
            "cwd": "${workspaceFolder}",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "type": "bun",
            "request": "launch",
            "name": "Debug process Script",
            "runtimeArgs": [
                "run",
                "main",
                "parse"
            ],
            "cwd": "${workspaceFolder}",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "type": "bun",
            "request": "launch",
            "name": "Debug crawl Script",
            "runtimeArgs": [
                "run",
                "main",
                "crawl"
            ],
            "cwd": "${workspaceFolder}",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "type": "bun",
            "request": "launch",
            "name": "Debug build Script",
            "runtimeArgs": [
                "run",
                "main",
                "yomitan"
            ],
            "cwd": "${workspaceFolder}",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}